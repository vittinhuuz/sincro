# Copie este arquivo para ".env" e preencha. NUNCA envie o .env para o GitHub.
# Chave que assina os logins (JWT). Gere uma com:  python -c "import secrets; print(secrets.token_hex(32))"
# Se ficar assim, o Sincro cria uma chave automática e guarda em .secret_key.
SECRET_KEY=troque-por-uma-frase-longa-e-aleatoria

# Chave grátis do Google AI Studio (aistudio.google.com)
GEMINI_API_KEY=cole_aqui_a_chave_do_google_ai_studio

# Opcional: modelo(s) preferido(s), separados por vírgula. Se vazio, usa gemini-3.8-flash e, se falhar,
# tenta gemini-3.6-flash e gemini-3.5-flash-lite automaticamente.
GEMINI_MODEL=

# Opcional
DB_PATH=sincro.db
IA_LIMITE_HORA=10
# FLASK_DEBUG=1   (só no seu computador, nunca em hospedagem)

# Opcional (hospedagem com disco temporário, como o Render grátis): cria sozinha uma conta de demonstração
# toda vez que o servidor inicia. Senha com 8+ caracteres, com letras e números.
# DEMO_EMAIL=demo@sincro.com
# DEMO_SENHA=Demo12345
